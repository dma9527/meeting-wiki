{
  "name": "meeting-wiki-desktop",
  "version": "0.1.5",
  "private": true,
  "description": "Local-first Meeting Wiki macOS recorder",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "electron-builder --mac"
  },
  "dependencies": {
    "audiotee": "0.0.7"
  },
  "devDependencies": {
    "electron": "41.10.7",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "dev.meetingwiki.desktop",
    "productName": "Meeting Wiki",
    "mac": {
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Meeting Wiki records your microphone only when you start a recording.",
        "NSScreenCaptureUsageDescription": "Meeting Wiki captures system audio only when you start a recording."
      }
    },
    "files": [
      "main.js",
      "capture.js",
      "runtime-paths.js",
      "status.js",
      "wiki-window.js",
      "wiki-store.js",
      "corrections-client.js",
      "memory-client.js",
      "preload.js",
      "managed-config.js",
      "setup-window.js",
      "setup-preload.js",
      "settings-window.js",
      "settings-preload.js",
      "live-session.js",
      "live-sidebar-window.js",
      "live-sidebar-preload.js",
      "secret-store.js",
      "assets/tray-idle@2x.png",
      "assets/tray-recording@2x.png",
      "assets/tray-processing@2x.png",
      "assets/tray-attention@2x.png",
      "renderer/**"
    ],
    "asarUnpack": ["node_modules/audiotee/**"],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ]
  }
}
