{
  "manifest_version": 3,
  "name": "Meeting Wiki for Google Meet",
  "version": "0.1.0",
  "description": "Tells the Meeting Wiki Mac app when you join or leave a Google Meet call. It reads no meeting content.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
